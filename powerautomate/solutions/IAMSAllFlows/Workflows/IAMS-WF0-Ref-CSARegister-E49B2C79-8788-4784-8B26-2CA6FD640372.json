{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mhao_sharedsharepointonline_iams"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "metadata": {
            "operationMetadataId": "b5eba68e-3ad3-49e5-b912-da77de08a49a"
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems"
            },
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "table": "@@LIST:IA_CSARegister@@"
            },
            "authentication": "@parameters('$authentication')"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            },
            "conditions": [
              {
                "expression": "@empty(triggerOutputs()?['body/CSAID'])"
              }
            ]
          }
        }
      },
      "actions": {
        "Compose_Ref": {
          "type": "Compose",
          "inputs": "@concat('CSA-', formatDateTime(utcNow(),'yyyy'), '-', formatNumber(triggerOutputs()?['body/ID'], '0000'))",
          "runAfter": {}
        },
        "Set_Reference": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists(guid'@@LIST:IA_CSARegister@@')/items(@{triggerOutputs()?['body/ID']})",
              "parameters/headers": {
                "X-HTTP-Method": "MERGE",
                "IF-MATCH": "*",
                "Content-Type": "application/json;odata=nometadata"
              },
              "parameters/body": "@concat('{\"CSAID\":\"', outputs('Compose_Ref'), '\"}')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "metadata": {
            "operationMetadataId": "ce44f5b0-a003-4fd9-8681-22e0b58575dc"
          },
          "runAfter": {
            "Compose_Ref": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}