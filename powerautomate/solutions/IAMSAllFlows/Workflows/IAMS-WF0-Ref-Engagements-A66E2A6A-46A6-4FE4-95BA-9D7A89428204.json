{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mhao_sharedsharepointonline_iams"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "38ac3e52-7d3a-4548-bc49-baaec8e6bd0d"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "table": "@@LIST:IA_Engagements@@"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Compose_Ref": {
          "runAfter": {
            "Get_item": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@concat('ENG-', string(coalesce(outputs('Get_item')?['body/PlanYear'], int(formatDateTime(utcNow(),'yyyy')))), '-', formatNumber(triggerOutputs()?['body/ID'], '0000'))"
        },
        "Set_Reference": {
          "runAfter": {
            "Compose_Ref": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c289d170-e12c-4498-88d9-383eddb6f854"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists(guid'@@LIST:IA_Engagements@@')/items(@{triggerOutputs()?['body/ID']})",
              "parameters/headers": {
                "X-HTTP-Method": "MERGE",
                "IF-MATCH": "*",
                "Content-Type": "application/json;odata=nometadata"
              },
              "parameters/body": "@concat('{\"EngagementID\":\"', outputs('Compose_Ref'), '\"}')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "HttpRequest",
              "connectionName": "shared_sharepointonline"
            }
          }
        },
        "Get_item": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "table": "@@LIST:IA_AuditPlan@@",
              "id": "@triggerOutputs()?['body/AuditPlanItem/Id']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline"
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}