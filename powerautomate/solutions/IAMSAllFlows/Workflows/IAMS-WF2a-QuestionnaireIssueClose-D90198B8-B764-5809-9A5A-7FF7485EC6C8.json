{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedsharepointonline_iams"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_iams"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_questionnaire_is_created_or_modified": {
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "table": "@@LIST:IA_Questionnaires@@"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "connectionName": "shared_sharepointonline"
            }
          }
        }
      },
      "actions": {
        "QstCode": {
          "runAfter": {
            "Get_item": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(triggerOutputs()?['body/QuestionnaireID'],concat('QST-',if(empty(outputs('Get_item')?['body/EngagementID']),formatDateTime(utcNow(),'yyyy'),substring(outputs('Get_item')?['body/EngagementID'],4,4)),'-',substring(concat('0000',string(triggerOutputs()?['body/ID'])),sub(length(concat('0000',string(triggerOutputs()?['body/ID']))),4),4)))"
        },
        "If_no_code": {
          "actions": {
            "Set_code": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                  "parameters/method": "POST",
                  "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),'@@LIST:IA_Questionnaires@@',decodeUriComponent('%27'),')/items(',triggerOutputs()?['body/ID'],')')",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata",
                    "X-HTTP-Method": "MERGE",
                    "IF-MATCH": "*"
                  },
                  "parameters/body": "@concat('{\"QuestionnaireID\":\"',outputs('QstCode'),'\"}')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "connectionName": "shared_sharepointonline"
                }
              }
            }
          },
          "runAfter": {
            "QstCode": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "equals": [
              "@empty(triggerOutputs()?['body/QuestionnaireID'])",
              true
            ]
          },
          "type": "If"
        },
        "Route_by_status": {
          "runAfter": {
            "If_no_code": [
              "Succeeded"
            ]
          },
          "cases": {
            "Issued": {
              "case": "Issued",
              "actions": {
                "If_not_yet_stamped": {
                  "actions": {
                    "Stamp_issued": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                          "parameters/method": "POST",
                          "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),'@@LIST:IA_Questionnaires@@',decodeUriComponent('%27'),')/items(',triggerOutputs()?['body/ID'],')')",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "X-HTTP-Method": "MERGE",
                            "IF-MATCH": "*"
                          },
                          "parameters/body": "@concat('{\"IssuedDate\":\"',utcNow(),'\"}')"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "HttpRequest",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    },
                    "Get_sections_issue": {
                      "runAfter": {
                        "Stamp_issued": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                          "parameters/method": "GET",
                          "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),'@@LIST:IA_QnrSections@@',decodeUriComponent('%27'),')/items?','$filter=QuestionnaireId eq ',triggerOutputs()?['body/ID'],'&$select=Id,Title,SectionNo,DueDate,Assignee/Title&$expand=Assignee&$orderby=SectionNo')",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata"
                          }
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "HttpRequest",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    },
                    "Each_section": {
                      "foreach": "@body('Get_sections_issue')?['value']",
                      "actions": {
                        "Mail_section": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "emailMessage/To": "user@example.com",
                              "emailMessage/Subject": "@concat('Questionnaire issued: ',triggerOutputs()?['body/Title'],' - section ',items('Each_section')?['Title'])",
                              "emailMessage/Body": "@concat('<p>Questionnaire <b>',outputs('QstCode'),'</b> has been issued.</p><p>Section: <b>',items('Each_section')?['Title'],'</b><br>Assignee: ',coalesce(items('Each_section')?['Assignee']?['Title'],'(not assigned)'),'<br>Due: ',coalesce(items('Each_section')?['DueDate'],'(not set)'),'</p>')",
                              "emailMessage/Importance": "Normal"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "operationId": "SendEmailV2",
                              "connectionName": "shared_office365"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Get_sections_issue": [
                          "Succeeded"
                        ]
                      },
                      "type": "Foreach"
                    },
                    "Audit_issued": {
                      "runAfter": {
                        "Each_section": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                          "table": "@@LIST:IA_AuditLog@@",
                          "item/Title": "@concat('Questionnaire issued: ',outputs('QstCode'))",
                          "item/SourceList": "Audit Questionnaires",
                          "item/SourceItemId": "@int(triggerOutputs()?['body/ID'])",
                          "item/EventType/Value": "Stage Change",
                          "item/EventDetails": "@concat('Issued round ',coalesce(triggerOutputs()?['body/Round'],1))"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "PostItem",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "equals": [
                      "@empty(triggerOutputs()?['body/IssuedDate'])",
                      true
                    ]
                  },
                  "type": "If"
                }
              }
            },
            "Closed": {
              "case": "Closed",
              "actions": {
                "Get_existing_closure": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                      "parameters/method": "GET",
                      "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),'@@LIST:IA_AuditLog@@',decodeUriComponent('%27'),')/items?$filter=SourceItemId eq ',triggerOutputs()?['body/ID'],' and EventType eq ',decodeUriComponent('%27'),'Closure',decodeUriComponent('%27'),' and SourceList eq ',decodeUriComponent('%27'),'Audit Questionnaires',decodeUriComponent('%27'),'&$select=Id')",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_sharepointonline"
                    }
                  }
                },
                "If_not_logged": {
                  "actions": {
                    "Audit_closed": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                          "table": "@@LIST:IA_AuditLog@@",
                          "item/Title": "@concat('Questionnaire closed: ',triggerOutputs()?['body/QuestionnaireID'])",
                          "item/SourceList": "Audit Questionnaires",
                          "item/SourceItemId": "@int(triggerOutputs()?['body/ID'])",
                          "item/EventType/Value": "Closure",
                          "item/EventDetails": "Questionnaire closed"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "PostItem",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    },
                    "Mail_closed": {
                      "runAfter": {
                        "Audit_closed": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "emailMessage/To": "user@example.com",
                          "emailMessage/Subject": "@concat('Questionnaire closed: ',triggerOutputs()?['body/QuestionnaireID'])",
                          "emailMessage/Body": "@concat('<p>Questionnaire <b>',triggerOutputs()?['body/Title'],'</b> was closed.</p>')",
                          "emailMessage/Importance": "Normal"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2",
                          "connectionName": "shared_office365"
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Get_existing_closure": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "equals": [
                      "@length(body('Get_existing_closure')?['value'])",
                      0
                    ]
                  },
                  "type": "If"
                }
              }
            }
          },
          "default": {
            "actions": {}
          },
          "expression": "@triggerOutputs()?['body/QuestionnaireStatus/Value']",
          "type": "Switch"
        },
        "Get_item": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "table": "@@LIST:IA_Engagements@@",
              "id": "@int(coalesce(triggerOutputs()?['body/Engagement/Id'], 0))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline"
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}