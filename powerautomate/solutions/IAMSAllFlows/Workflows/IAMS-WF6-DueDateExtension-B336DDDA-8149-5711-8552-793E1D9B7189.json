{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedsharepointonline_iams"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_iams"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedapprovals_iams"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "ItemType",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter ItemType",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "ItemId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter ItemId",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "NewDueDate",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter NewDueDate",
                  "x-ms-content-hint": "TEXT"
                },
                "text_3": {
                  "title": "Reason",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter Reason",
                  "x-ms-content-hint": "TEXT"
                },
                "text_4": {
                  "title": "RequesterEmail",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter RequesterEmail",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2",
                "text_3",
                "text_4"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_current": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
              "parameters/method": "GET",
              "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),if(equals(triggerBody()?['text'],'Finding'),'@@LIST:IA_Findings@@','@@LIST:IA_ActionPlans@@'),decodeUriComponent('%27'),')/items(',triggerBody()?['text_1'],')?$select=Id,Title,DueDate,OriginalDueDate,ExtensionCount')",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "NewDue": {
          "runAfter": {
            "Get_current": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@concat(triggerBody()?['text_2'],'T08:00:00Z')"
        },
        "Validate_new_date": {
          "runAfter": {
            "NewDue": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@ticks(outputs('NewDue'))",
              "@ticks(body('Get_current')?['DueDate'])"
            ]
          },
          "actions": {
            "Respond_submitted": {
              "runAfter": {},
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "result": "Submitted for approval. You will be notified by email of the outcome."
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "title": "result",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              }
            },
            "Approval_1_Audit_Manager": {
              "runAfter": {
                "Respond_submitted": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connectionName": "shared_approvals",
                  "operationId": "StartAndWaitForAnApproval",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                },
                "parameters": {
                  "approvalType": "Basic",
                  "WebhookApprovalCreationInput/title": "@concat('Due-date extension: ',body('Get_current')?['Title'])",
                  "WebhookApprovalCreationInput/assignedTo": "user@example.com",
                  "WebhookApprovalCreationInput/details": "@concat('New due date ',outputs('NewDue'),'. Reason: ',triggerBody()?['text_3'])",
                  "WebhookApprovalCreationInput/enableNotifications": true,
                  "WebhookApprovalCreationInput/enableReassignment": true
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_approved_1": {
              "runAfter": {
                "Approval_1_Audit_Manager": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@outputs('Approval_1_Audit_Manager')?['body/outcome']",
                  "Approve"
                ]
              },
              "actions": {
                "Get_rating": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                      "parameters/method": "GET",
                      "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),if(equals(triggerBody()?['text'],'Finding'),'@@LIST:IA_Findings@@','@@LIST:IA_ActionPlans@@'),decodeUriComponent('%27'),')/items(',triggerBody()?['text_1'],')?$select=',if(equals(triggerBody()?['text'],'Finding'),'Rating','FindingRating'))",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Rating": {
                  "runAfter": {
                    "Get_rating": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@coalesce(body('Get_rating')?['Rating'],body('Get_rating')?['FindingRating'],'Low')"
                },
                "If_high_rating": {
                  "runAfter": {
                    "Rating": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@outputs('Rating')",
                          "Critical"
                        ]
                      },
                      {
                        "equals": [
                          "@outputs('Rating')",
                          "High"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Approval_2_Head_of_IA": {
                      "runAfter": {},
                      "type": "OpenApiConnectionWebhook",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_approvals",
                          "operationId": "StartAndWaitForAnApproval",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                        },
                        "parameters": {
                          "approvalType": "Basic",
                          "WebhookApprovalCreationInput/title": "@concat('2nd approval, due-date extension: ',body('Get_current')?['Title'])",
                          "WebhookApprovalCreationInput/assignedTo": "user@example.com",
                          "WebhookApprovalCreationInput/details": "@concat('High/Critical item. New due date ',outputs('NewDue'),'. Reason: ',triggerBody()?['text_3'])",
                          "WebhookApprovalCreationInput/enableNotifications": true,
                          "WebhookApprovalCreationInput/enableReassignment": true
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "If_approved_2": {
                      "runAfter": {
                        "Approval_2_Head_of_IA": [
                          "Succeeded"
                        ]
                      },
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@outputs('Approval_2_Head_of_IA')?['body/outcome']",
                          "Approve"
                        ]
                      },
                      "actions": {
                        "Apply_new_due_date_hi": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_sharepointonline",
                              "operationId": "HttpRequest",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                              "parameters/method": "POST",
                              "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),if(equals(triggerBody()?['text'],'Finding'),'@@LIST:IA_Findings@@','@@LIST:IA_ActionPlans@@'),decodeUriComponent('%27'),')/items(',triggerBody()?['text_1'],')')",
                              "parameters/headers": {
                                "Accept": "application/json;odata=nometadata",
                                "Content-Type": "application/json;odata=nometadata",
                                "X-HTTP-Method": "MERGE",
                                "IF-MATCH": "*"
                              },
                              "parameters/body": "@concat('{\"DueDate\":\"',outputs('NewDue'),'\",\"ExtensionCount\":',add(coalesce(body('Get_current')?['ExtensionCount'],0),1),',\"OriginalDueDate\":\"',coalesce(body('Get_current')?['OriginalDueDate'],body('Get_current')?['DueDate']),'\"',if(equals(triggerBody()?['text'],'Action'),',\"ReminderStage\":\"None\"',''),'}')"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Audit_approved_hi": {
                          "runAfter": {
                            "Apply_new_due_date_hi": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                              "table": "@@LIST:IA_AuditLog@@",
                              "item/Title": "@concat('Due date extended: ',body('Get_current')?['Title'])",
                              "item/SourceList": "@if(equals(triggerBody()?['text'],'Finding'),'Audit Findings Register','Corrective Action Tracker')",
                              "item/SourceItemId": "@int(triggerBody()?['text_1'])",
                              "item/EventType/Value": "Due Date Extension",
                              "item/EventDetails": "@concat('Old: ',body('Get_current')?['DueDate'],' New: ',outputs('NewDue'),' Reason: ',triggerBody()?['text_3'],' Requested by: ',triggerBody()?['text_4'])"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Tell_requester_hi": {
                          "runAfter": {
                            "Audit_approved_hi": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_office365",
                              "operationId": "SendEmailV2",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                            },
                            "parameters": {
                              "emailMessage/To": "@triggerBody()?['text_4']",
                              "emailMessage/Subject": "Due-date extension approved",
                              "emailMessage/Body": "<p>Your extension request for <b>@{body('Get_current')?['Title']}</b> was approved. New due date: @{outputs('NewDue')}.</p>",
                              "emailMessage/Importance": "Normal"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Tell_requester_rejected_hi": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_office365",
                                "operationId": "SendEmailV2",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                              },
                              "parameters": {
                                "emailMessage/To": "@triggerBody()?['text_4']",
                                "emailMessage/Subject": "Due-date extension rejected",
                                "emailMessage/Body": "<p>Your extension request for <b>@{body('Get_current')?['Title']}</b> was rejected.</p>",
                                "emailMessage/Importance": "Normal"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Apply_new_due_date_lo": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "HttpRequest",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                            "parameters/method": "POST",
                            "parameters/uri": "@concat('_api/web/lists(guid',decodeUriComponent('%27'),if(equals(triggerBody()?['text'],'Finding'),'@@LIST:IA_Findings@@','@@LIST:IA_ActionPlans@@'),decodeUriComponent('%27'),')/items(',triggerBody()?['text_1'],')')",
                            "parameters/headers": {
                              "Accept": "application/json;odata=nometadata",
                              "Content-Type": "application/json;odata=nometadata",
                              "X-HTTP-Method": "MERGE",
                              "IF-MATCH": "*"
                            },
                            "parameters/body": "@concat('{\"DueDate\":\"',outputs('NewDue'),'\",\"ExtensionCount\":',add(coalesce(body('Get_current')?['ExtensionCount'],0),1),',\"OriginalDueDate\":\"',coalesce(body('Get_current')?['OriginalDueDate'],body('Get_current')?['DueDate']),'\"',if(equals(triggerBody()?['text'],'Action'),',\"ReminderStage\":\"None\"',''),'}')"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Audit_approved_lo": {
                        "runAfter": {
                          "Apply_new_due_date_lo": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PostItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "https://YOURTENANT.sharepoint.com/sites/InternalAuditTest",
                            "table": "@@LIST:IA_AuditLog@@",
                            "item/Title": "@concat('Due date extended: ',body('Get_current')?['Title'])",
                            "item/SourceList": "@if(equals(triggerBody()?['text'],'Finding'),'Audit Findings Register','Corrective Action Tracker')",
                            "item/SourceItemId": "@int(triggerBody()?['text_1'])",
                            "item/EventType/Value": "Due Date Extension",
                            "item/EventDetails": "@concat('Old: ',body('Get_current')?['DueDate'],' New: ',outputs('NewDue'),' Reason: ',triggerBody()?['text_3'],' Requested by: ',triggerBody()?['text_4'])"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Tell_requester_lo": {
                        "runAfter": {
                          "Audit_approved_lo": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_office365",
                            "operationId": "SendEmailV2",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                          },
                          "parameters": {
                            "emailMessage/To": "@triggerBody()?['text_4']",
                            "emailMessage/Subject": "Due-date extension approved",
                            "emailMessage/Body": "<p>Your extension request for <b>@{body('Get_current')?['Title']}</b> was approved. New due date: @{outputs('NewDue')}.</p>",
                            "emailMessage/Importance": "Normal"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Tell_requester_rejected_1": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "emailMessage/To": "@triggerBody()?['text_4']",
                        "emailMessage/Subject": "Due-date extension rejected",
                        "emailMessage/Body": "<p>Your extension request for <b>@{body('Get_current')?['Title']}</b> was rejected.</p>",
                        "emailMessage/Importance": "Normal"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Respond_invalid": {
                "runAfter": {},
                "type": "Response",
                "kind": "PowerApp",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "result": "Error: the new due date must be later than the current due date."
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "result": {
                        "title": "result",
                        "x-ms-dynamically-added": true,
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}