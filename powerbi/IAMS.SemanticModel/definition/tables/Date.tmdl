table Date
	dataCategory: Time

	/// Caption for the printable report page.
	measure 'Report Date Text' = "Generated " & FORMAT(TODAY(), "dd mmm yyyy")
		displayFolder: Report

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		isKey
		sourceColumn: Date
		summarizeBy: none

	column Year
		dataType: int64
		formatString: 0
		sourceColumn: Year
		summarizeBy: none

	column 'Year-Month'
		dataType: string
		sourceColumn: Year-Month
		summarizeBy: none

	partition Date = m
		mode: import
		source =
				let
				Days = List.Dates(#date(2024, 1, 1), 2557, #duration(1, 0, 0, 0)),
				T = Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}),
				Typed = Table.TransformColumnTypes(T, {{"Date", type date}}),
				Yr = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				Ym = Table.AddColumn(Yr, "Year-Month", each Date.ToText([Date], "yyyy-MM"), type text)
				in
					Ym

